  "risk_mapping_policy": {
    "evidence_status": "PENDING",
    "review_reason": "S/E/C判据由V13回归逻辑迁移，须结合项目碰撞、暴露和接管数据批准",
    "severity": {
      "object_rules": [
        {"rule_id": "AVP-S-PED-001", "object_tokens": ["行人", "pedestrian"], "geometry_tokens": ["pedestrian"], "bands": [
          {"min_inclusive_kph": 0, "max_exclusive_kph": 15, "score": "S1", "basis": "低速车辆-行人碰撞可能造成轻中度伤害"},
          {"min_inclusive_kph": 15, "max_exclusive_kph": 30, "score": "S2", "basis": "相对速度升高，行人可能遭受严重伤害"},
          {"min_inclusive_kph": 30, "max_exclusive_kph": null, "score": "S3", "basis": "较高相对速度下存在危及生命或致命伤害风险"}
        ]},
        {"rule_id": "AVP-S-VEH-001", "object_tokens": ["车辆", "vehicle", "car"], "geometry_tokens": ["vehicle", "frontal", "rear"], "bands": [
          {"min_inclusive_kph": 0, "max_exclusive_kph": 15, "score": "S0", "basis": "低相对速度车辆碰撞预期无人员伤害"},
          {"min_inclusive_kph": 15, "max_exclusive_kph": 30, "score": "S1", "basis": "低速车辆碰撞可能造成轻中度伤害"},
          {"min_inclusive_kph": 30, "max_exclusive_kph": 50, "score": "S2", "basis": "中等相对速度车辆碰撞可能造成严重伤害"},
          {"min_inclusive_kph": 50, "max_exclusive_kph": null, "score": "S3", "basis": "较高相对速度车辆碰撞可能危及生命"}
        ]},
        {"rule_id": "AVP-S-FIXED-001", "object_tokens": ["墙", "柱", "wall", "column"], "geometry_tokens": ["fixed-object"], "bands": [
          {"min_inclusive_kph": 0, "max_exclusive_kph": 15, "score": "S0", "basis": "AVP低速固定障碍物碰撞预期无人员伤害"},
          {"min_inclusive_kph": 15, "max_exclusive_kph": 30, "score": "S1", "basis": "固定障碍物碰撞可能造成轻中度伤害"},
          {"min_inclusive_kph": 30, "max_exclusive_kph": null, "score": "S2", "basis": "较高相对速度固定障碍物碰撞可能造成严重伤害"}
        ]},
        {"rule_id": "AVP-S-NOCONFLICT-001", "object_tokens": ["无近距离冲突", "none"], "geometry_tokens": ["none"], "bands": [
          {"min_inclusive_kph": 0, "max_exclusive_kph": null, "score": "S0", "basis": "无近距离冲突目标，预期无人员伤害"}
        ]}
      ]
    },
    "exposure": {"source": "risk_candidates.exposure_level_candidate+exposure_method", "requires_project_confirmation": true},
    "controllability": {"control_context_rules": [
      {"rule_id": "AVP-C-REMOTE-001", "driver_position": "outside", "direct_vehicle_control": false, "score": "C3", "basis": "驾驶员不在驾驶位且无方向盘/制动踏板控制权，只能远程请求停止"},
      {"rule_id": "AVP-C-DIRECT-001", "driver_position": "inside", "direct_vehicle_control": true, "score": "C1", "basis": "驾驶员位于驾驶位，可直接通过制动、转向或档位干预"}
    ]}
  },
  "safety_goals": {
    "definitions": {
      "SG_AVP_01": {
        "category": "纵向驱动控制",
        "safety_goal": "应防止AVP输出非预期或超限的驱动扭矩。",
        "safety_state": "驱动扭矩置零，受控制动至静止并保持驻车，退出AVP控制并向远程用户报警。"
      },
      "SG_AVP_02": {
        "category": "纵向制动控制",
        "safety_goal": "应确保AVP按需、及时且受控地建立制动力，使车辆避免碰撞并可进入静止状态。",
        "safety_state": "切断驱动扭矩，使用可用的独立制动能力受控制动至静止，保持驻车并退出AVP控制。"
      },
      "SG_AVP_03": {
        "category": "横向转向控制",
        "safety_goal": "应防止AVP输出非预期或超限的转向控制，使车辆保持在规划轨迹和可行驶区域内。",
        "safety_state": "限制或撤销转向请求，切断驱动扭矩，受控制动至静止并保持驻车，退出AVP控制。"
      },
      "SG_AVP_04": {
        "category": "激活与起步许可",
        "safety_goal": "应仅在全部激活条件及ODD约束满足时允许AVP激活和起步。",
        "safety_state": "禁止AVP激活或起步，保持车辆静止，并向远程用户报告未满足的前置条件或系统故障。"
      },
      "SG_AVP_05": {
        "category": "退出与关闭",
        "safety_goal": "应保证AVP退出或关闭请求得到及时执行，并在退出过程中保持车辆受控。",
        "safety_state": "停止新的运动控制请求，受控制动至静止，驱动扭矩置零并保持驻车，完成AVP退出并报警。"
      },
      "SG_AVP_06": {
        "category": "驻车保持",
        "safety_goal": "应在车辆静止时提供足够且持续的驻车保持能力，防止非预期移动。",
        "safety_state": "保持车辆静止，驱动扭矩置零，施加可用的冗余驻车保持能力并向远程用户报警。"
      },
      "SG_AVP_07": {
        "category": "安全相关提示",
        "safety_goal": "应及时、正确地向远程用户提供安全相关状态和故障警告。",
        "safety_state": "触发独立故障提示；若无法确认远程用户已收到警告，则受控制动至静止并保持驻车。"
      }
    },
    "function_mapping": {
      "输出驱动扭矩": "SG_AVP_01",
      "输出制动扭矩": "SG_AVP_02",
      "输出转向扭矩": "SG_AVP_03",
      "开启功能": "SG_AVP_04",
      "激活功能": "SG_AVP_04",
      "退出功能": "SG_AVP_05",
      "关闭功能": "SG_AVP_05",
      "输出驻车制动": "SG_AVP_06",
      "报警提示": "SG_AVP_07"
    },
    "token_mapping": [
      ["驱动扭矩", "SG_AVP_01"],
      ["制动扭矩", "SG_AVP_02"],
      ["转向扭矩", "SG_AVP_03"],
      ["驻车制动", "SG_AVP_06"],
      ["报警", "SG_AVP_07"],
      ["激活", "SG_AVP_04"],
      ["开启", "SG_AVP_04"],
      ["退出", "SG_AVP_05"],
      ["关闭", "SG_AVP_05"]
    ]
  }
}
