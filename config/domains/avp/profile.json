        "driver_state": "驾驶员不在驾驶位，仅能远程监控或发出停止请求",
        "direct_vehicle_control": false,
        "intervention_channels": ["remote_stop_request"]
      }
    ],
    "drive_acceleration_mps2": 3.0,
    "brake_deceleration_mps2": -3.0,
    "steering_control_error_deg": 0.1
  },
